#!/usr/bin/env bash
# 一次性安装：装 Pi、把本目录注册成 Pi 包、跑冒烟测试。
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$HERE"

echo "== 1/4 检查 Python 与视频依赖 =="
python3 tools/videoctl.py check || {
  echo "环境自检未通过，先解决上面的问题再继续。" >&2
  exit 1
}

echo "== 2/4 检查 Pi =="
if ! command -v pi >/dev/null 2>&1; then
  echo "未检测到 pi，正在安装…"
  curl -fsSL https://pi.dev/install.sh | sh
fi
pi --version

echo "== 检查 Node（Web 工作台要用） =="
if command -v node >/dev/null 2>&1; then
  node -v
else
  echo "未检测到 node；Web 界面需要 Node ≥ 22.19（命令行用法不受影响）。" >&2
fi

echo "== 3/4 把工作台注册为 Pi 包（用户作用域，任何目录都能用） =="
pi install "$HERE"

echo "== 4/4 冒烟测试 =="
node tools/verify_workbench.mjs

cat <<'TIP'

完成。接下来：
  网页版（推荐）：$HERE/bin/web
                  打开后右上角「⚙ 模型」填自己的 API Key（BYOK），或点「导入本机 Pi 配置」
  命令行版：      cd <任意目录> && pi
  命令行版先用 /login 连一个模型，然后：
  /video 勾股定理的可视化证明
TIP
